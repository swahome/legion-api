# Copy to .env next to the legion-api binary (or point LEGION_ENV_FILE at it).
# Real environment variables override values in this file.

# In production bind to loopback behind the web server, e.g. 127.0.0.1:8089 (see README).
LEGION_ADDR=:8080
DATABASE_URL=postgres://legion:legion@localhost:5432/legion?sslmode=disable

# Generate with: openssl rand -base64 48
LEGION_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
LEGION_ACCESS_TTL=15m
LEGION_REFRESH_TTL=720h

# Set to true in production (HTTPS). false only for local http://localhost.
LEGION_COOKIE_SECURE=false

LEGION_MIGRATE_ON_START=true
LEGION_DEFAULT_CALLING_CODE=254

# The legacy mobile app's key files (from the old assets/certificates folder).
# Set both to serve the app on /v1/legacy; keep them out of git.
# LEGION_MOBILE_SERVER_KEY=/etc/legion/10.184.38.64.key
# LEGION_MOBILE_APP_CERT=/etc/legion/mobile.crt

# Groups' calendar, and the daily time the billing job raises contribution
# invoices and late-payment fines. LEGION_BILLING_AT=off turns it off (run
# it with `legion-api billing-run` instead).
LEGION_TIMEZONE=Africa/Nairobi
LEGION_BILLING_AT=00:30

# The web app's address, for the links in invite texts.
LEGION_WEB_URL=http://localhost:5173

# Africa's Talking SMS (sign-up codes, password resets, invites). Use the
# username "sandbox" with a sandbox key to test. Leave unset in development:
# texts, with their codes, are then written to the server log instead.
# LEGION_AT_USERNAME=sandbox
# LEGION_AT_API_KEY=
# LEGION_AT_SENDER_ID=

# Payments (docs/api/payments.md). LEGION_PUBLIC_URL is the address the
# banks and Chamasoft call back on (default LEGION_WEB_URL). LEGION_HOOK_KEY
# signs callback URLs and webhook keys (default LEGION_JWT_SECRET); changing
# it changes the keys `legion-api hook-urls` prints.
# LEGION_PUBLIC_URL=https://legion.com
# LEGION_HOOK_KEY=

# Chamasoft payment API for MPesa prompts. AUTH is user:password for the
# token endpoint; CERT is Chamasoft's public key or certificate (PEM).
# LEGION_CHAMASOFT_FAKE=true simulates payments in development.
# LEGION_CHAMASOFT_URL=
# LEGION_CHAMASOFT_AUTH=
# LEGION_CHAMASOFT_CERT=/etc/legion/chamasoft.pem
# Comma-separated source IPs allowed on the direct paybill hook.
# LEGION_CHAMASOFT_IPS=
# LEGION_CHAMASOFT_FAKE=false

# Bank feeds. A feed with neither credentials nor IPs is switched off.
# LEGION_EQUITY_USERNAME=
# LEGION_EQUITY_PASSWORD=
# LEGION_EQUITY_IPS=
# LEGION_COOP_USERNAME=
# LEGION_COOP_PASSWORD=
# LEGION_COOP_IPS=

# USSD and WhatsApp (docs/api/channels.md). `legion-api hook-urls` prints
# the callback URLs to give Africa's Talking (USSD) and Twilio (WhatsApp).
# LEGION_USSD_IPS pins Africa's Talking's source IPs (optional).
# LEGION_TWILIO_AUTH_TOKEN checks Twilio's signature on WhatsApp messages.
# LEGION_BRAND is the name callers see in the menus.
# LEGION_USSD_IPS=
# LEGION_TWILIO_AUTH_TOKEN=
# LEGION_BRAND=Legion

# Only used by `make test`.
TEST_DATABASE_URL=postgres://legion:legion@localhost:5432/legion?sslmode=disable
